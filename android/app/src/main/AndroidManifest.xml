<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Reading the OEM dialer's output. READ_MEDIA_AUDIO is the API 33+ form. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Cheapest reliable "a call just ended" trigger. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Hard-restricted on Android 10+. A plain sideload may never be able to
         hold it; the app is fully functional without it (correlation degrades
         to filename + mtime, direction becomes "unknown", call_id becomes null). -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <!-- Name for a number the call log did not cache. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Phone events (build step 6): payment SMS become transactions on the
         owner's OWN server; nothing goes to any third party. Both are in the
         same hard-restricted group as READ_CALL_LOG, so a sideload may never
         hold them — the app degrades (no SMS upload), never breaks.
         RECEIVE_SMS only wakes the sync worker; READ_SMS is what it reads. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Opt-in "advanced mode" only. NEVER required to launch. Cannot reach
         /Android/data, so it does not rescue Google Dialer recordings. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Deliberately ABSENT: RECORD_AUDIO. This app never captures audio.
         See README "What this cannot do". -->

    <!-- targetSdk 36 hides other packages from us unless they are declared
         here. Without this, every explicit-component intent in OemHints
         (autostart, battery, "no restrictions") throws ActivityNotFound and
         silently degrades to the generic app-details page — on exactly the
         phones where those screens are the load-bearing manual step. -->
    <queries>
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.miui.powerkeeper" />
        <package android:name="com.samsung.android.lool" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.iqoo.secure" />
    </queries>

    <application
        android:name=".MiyaApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Miya">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Miya">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The only path that works on a Google-Dialer phone: the owner
             shares a recording out of the Phone app into MIYA. -->
        <activity
            android:name=".ui.ShareReceiverActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_target_label"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.IngestService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- WorkManager's own foreground component, redeclared only to give it
             a type. ScanWorker and UploadWorker both return a ForegroundInfo
             with FOREGROUND_SERVICE_TYPE_DATA_SYNC, and WorkManager passes
             that straight to startForeground() on this service. Since API 29
             the type passed must be a subset of the type declared in the
             manifest for that component, and the WorkManager library manifest
             declares none — so without this merge an expedited worker throws
             "foregroundServiceType 0x00000001 is not a subset of
             foregroundServiceType attribute 0x0 in service element" on every
             Android 10/11 launch. It is also the documented requirement for
             setForeground() on Android 14+. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <receiver
            android:name=".watch.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Wake-up only: enqueues EventSyncWorker and returns. The
             BROADCAST_SMS sender permission means only the system's telephony
             stack can fire it. Delivery requires this app to hold RECEIVE_SMS;
             the worker reads the SMS provider itself, so a missed broadcast
             (force-stop, Doze) costs latency, never a message. -->
        <receiver
            android:name=".watch.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
