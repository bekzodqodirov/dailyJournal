# MIYA configuration. Copy to .env and fill in. NEVER commit .env.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=miya
POSTGRES_PASSWORD=change-me
POSTGRES_DB=miya
DATABASE_URL=postgresql+psycopg://miya:change-me@db:5432/miya
# Host port for psql from outside the containers. Change it if this
# machine already runs Postgres on 5432 — the containers are unaffected,
# they always reach the database as db:5432.
DB_PORT=5432

# --- Anthropic (egress: text leaves the server) -----------------------------
ANTHROPIC_API_KEY=
EXTRACT_MODEL=claude-haiku-4-5
REASON_MODEL=claude-sonnet-5
# Person profiles: blank model = EXTRACT_MODEL. A profile is rewritten at most
# once per PROFILE_MIN_AGE_HOURS, and at most PROFILE_DAILY_CAP a day (0 = off).
# Prices of the two model roles, "input,output" USD per million tokens.
# Blank uses the built-in table; set them when you change a model.
EXTRACT_MODEL_PRICE=
REASON_MODEL_PRICE=
# Warn in Telegram when MIYA's own API spend passes these (USD; 0 = off).
SPEND_ALERT_DAILY_USD=5
SPEND_ALERT_MONTHLY_USD=60
PROFILE_MODEL=
PROFILE_MIN_AGE_HOURS=24
PROFILE_DAILY_CAP=30
PROFILE_REFRESH_PER_RUN=5

# --- ElevenLabs Scribe (egress: audio leaves the server) --------------------
ELEVENLABS_API_KEY=
# future: local_whisper
TRANSCRIBER=elevenlabs

# --- Embeddings (local, no egress) ------------------------------------------
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
# Leave blank here: docker-compose sets it for bot/worker so only the api
# container loads the ~2 GB model.
EMBED_SERVICE_URL=
# Embedder memory bounds: tokens per text, texts per batch.
EMBED_MAX_SEQ_LENGTH=512
EMBED_BATCH_SIZE=16
# /holat says search is down when a memory waits this many minutes for its vector.
EMBED_STALE_MINUTES=60
# This many API restarts within an hour is reported (usually too little RAM).
API_RESTART_ALERT_COUNT=3
# An outside watcher for a dead server: a healthchecks.io-style ping URL that
# the worker hits every DEADMAN_PING_MINUTES (a bare GET, no data). Blank = off.
DEADMAN_PING_URL=
DEADMAN_PING_MINUTES=5

# --- Telegram ---------------------------------------------------------------
ASSISTANT_BOT_TOKEN=
OWNER_TELEGRAM_ID=
USERBOT_ENABLED=true
# https://my.telegram.org → API development tools
TELETHON_API_ID=
TELETHON_API_HASH=
# generate: make userbot-login (a full credential)
TELETHON_SESSION=
# How people address you in groups, comma-separated. A group message that
# contains one of these as a whole word counts as aimed at you, exactly like
# an @-mention — Latin or Cyrillic spelling, any case (each Latin alias is
# also matched in its Cyrillic transliteration; a Cyrillic one listed here is
# matched as written). Private chats need no aliases: every message is yours.
# Example: OWNER_ALIASES=Bekzod, Begi, Bekzod aka, bekzodaka, Begika, Bega, GSR Logistics, @your_username

# --- Client codes (GS367) and waybills (YW26-004715) ---
# The letters in front of a client's code; comma-separated if there are several.
CLIENT_CODE_PREFIXES=GS
# The longest code number (GS followed by at most this many digits).
CLIENT_CODE_MAX_DIGITS=6
# true: GS0367 and GS367 are the same client.
CLIENT_CODE_STRIP_LEADING_ZEROS=true
# The letters in front of a waybill number.
WAYBILL_PREFIXES=YW
# After a restart the userbot re-reads allowed chats past the last message
# it saw, every this many minutes (never before a chat was switched on).
USERBOT_CATCHUP_MINUTES=30
# At most this many messages per chat and this many chats per pass.
USERBOT_CATCHUP_MAX_PER_CHAT=500
USERBOT_CATCHUP_MAX_CHATS=20
# An @username entry matches the written @mention; put your real username in
# .env only, never in this file (the repository is public).
OWNER_ALIASES=
# In a group where someone else spoke under the same first name within this
# many days, a bare "Bekzod" is only "maybe to you" (/menga shows it apart).
OWNER_ALIAS_NAMESAKE_DAYS=90

# --- Open loops (what slipped your attention) --------------------------------
# A question in a chat that you have not answered is nudged after this long.
LOOP_QUESTION_HOURS=4
# A question older than this many days is no longer a loop and is not looked
# at (at least 1). It is also what keeps the half-hourly scan fast.
LOOP_QUESTION_MAX_DAYS=30
# An undated promise or debt untouched this long is ageing; the weekly
# "Hali ochiqmi?" question uses the same threshold, and so does the re-ask of
# a dated item you said is still open ("Ha") or a question you never
# answered. One knob for "re-remind after one week" (at least 1).
LOOP_UNDATED_DAYS=7
# Someone with an open debt or promise not heard from for this long is quiet.
LOOP_QUIET_DAYS=14
# When the morning brief arrives (your timezone). It is never skipped, so it
# must be outside QUIET_HOURS — MIYA refuses to start otherwise.
MORNING_BRIEF_TIME=09:00

# --- Userbot conversation windows -------------------------------------------
WINDOW_IDLE_MINUTES=30
# Private chats and group messages aimed at you close their window after this
# much silence and are extracted at once, not on the next batch.
WINDOW_IDLE_MINUTES_ADDRESSED=5
WINDOW_MAX_MESSAGES=25
WINDOW_MAX_CHARS=4000
BATCH_MAX_ATTEMPTS=3

# --- Documents (parsed locally, no egress) ----------------------------------
# 20 MB
DOC_MAX_BYTES=20971520
DOC_MAX_CHARS=15000

# --- Audio files ------------------------------------------------------------
# Cap for audio *files* (music, podcasts) in monitored chats; voice notes are
# always transcribed. Oversized files are skipped, not billed to Scribe.
# 30 MB
AUDIO_MAX_BYTES=31457280

# --- Oversized media --------------------------------------------------------
# Anything past the caps above, and every video, is not fetched on sight: MIYA
# asks in Telegram and downloads only on a yes. Past this ceiling it does not
# even ask.
# 500 MB
MEDIA_ASK_MAX_BYTES=524288000
MEDIA_ASK_EXPIRY_HOURS=48

# --- Google Calendar (egress: event data leaves the server) -----------------
GOOGLE_OAUTH_CLIENT_JSON=./secrets/google_oauth.json
# created by `make gcal-auth`
GOOGLE_TOKEN_JSON=./secrets/google_token.json
GCAL_CALENDAR_ID=primary
GCAL_PULL_MINUTES=30
GCAL_DAYS_AHEAD=14

# --- Call recordings --------------------------------------------------------
CALL_RECORDINGS_DIR=/data/call_recordings
AUDIO_RETENTION_DAYS=90

# --- Phone events (call log, SMS) -------------------------------------------
# A missed call younger than this may just mean you are on another call; it
# becomes an open loop (and, once, a nudge) only after this many minutes.
LOOP_MISSED_CALL_MINUTES=45
# ... and stops being one after this many days (at least 1).
LOOP_MISSED_CALL_MAX_DAYS=3
# Extra payment/bank SMS senders on top of the built-in list (Payme, Click,
# Uzum, the banks, 8600, ...), comma- or space-separated. Matching ignores
# case, spaces and punctuation, so "Kapital Bank" and KAPITALBANK agree.
PAYMENT_SMS_SENDERS=
# Bank adverts (cashback, promo) are ignored; true sends them to /tekshir.
PAYMENT_ADVERTS_TO_REVIEW=false
# Package ids of the payment apps whose notifications may book money, read off
# the phone (comma- or space-separated). Empty trusts the phone's allow-list.
PAYMENT_APP_PACKAGES=
# false sends every completed payment to /tekshir instead of booking it.
MONEY_AUTOBOOK=true
# One payment seen by SMS and by app push within this many minutes is booked once.
PAYMENT_DEDUPE_WINDOW_MINUTES=10
# The same text re-posted within this many seconds is not a second payment.
PAYMENT_REPEAT_SECONDS=120
# A Telegram receipt per booked payment: each or off.
MONEY_RECEIPTS=each
# This many receipts at once are folded into one message.
MONEY_RECEIPTS_FOLD_AT=4
# Payments older than this many hours (a first import) are only summarised.
MONEY_RECEIPT_MAX_AGE_HOURS=12
# true: receipts arrive silently in quiet hours; false: they wait until morning.
MONEY_RECEIPTS_SILENT_AT_NIGHT=false
# A payment you typed and the bank's SMS/push of the same amount, same day,
# within this many hours are one payment (0 = never match).
MONEY_TYPED_MATCH_HOURS=6
# true: a short "SMS tasdiqladi" receipt when the bank confirms a typed payment.
MONEY_RECEIPT_ON_TYPED_MATCH=false

# --- The question budget (owner: 5-10 taps a day) ---------------------------
# Most taps a day the bot may ask for (0 = never push; brief line and /savollar only).
QUESTION_BUDGET_PER_DAY=10
# Of those, how many ride on the morning brief.
QUESTION_BRIEF_SLOTS=5
# And how many on the evening report.
QUESTION_EVENING_SLOTS=3
# At most this many questions in one pushed message (1-10).
QUESTION_BATCH_MAX=5
# At least this many minutes between two pushed question messages.
QUESTION_PUSH_GAP_MINUTES=120
# Money at stake (so'm) that moves a question up the queue; never shown.
QUESTION_URGENT_MIN_UZS=5000000
# How many undecided groups one digest lists (each costs one slot).
QUESTION_GROUP_DIGEST_SIZE=3
# How many times one group is offered before it is left off.
QUESTION_GROUP_MAX_SHOWS=2
# A group needs this many messages before it is offered.
QUESTION_GROUP_MIN_MESSAGES=1
# true also offers channels, not only groups.
QUESTION_ASK_CHANNELS=false
# A claim no receipt showed is queued after this many minutes.
CLAIM_ASK_AFTER_MINUTES=10
# A repeat of a claim within this many days is folded into the first.
CLAIM_DUPLICATE_DAYS=14
# A bank payment within this many hours can settle a money claim.
CLAIM_BANK_MATCH_HOURS=48
# A payment claim the bank confirmed is closed without asking.
CLAIM_BANK_AUTOCLOSE_TRANSACTIONS=true
# true also accepts "I paid you back" when the bank shows it.
CLAIM_BANK_AUTOACCEPT_SETTLEMENTS=false
# true also asks about big files posted in groups.
MEDIA_ASK_IN_GROUPS=false
# true also asks about big files the owner sent.
MEDIA_ASK_OUTGOING=false
# A big-file question never asked is dropped after this many days.
MEDIA_UNASKED_EXPIRY_DAYS=7

# --- Encrypted backups (spec §10) -------------------------------------------
BACKUP_DIR=/data/backups
BACKUP_RETENTION_DAYS=14
BACKUP_TIME=03:30
# age public key (age1…). Leave blank and no backup is written at all —
# an unencrypted dump of this database is never an acceptable fallback.
# Generate with: make backup-key (it prints the line to paste here)
BACKUP_AGE_RECIPIENT=
# Also send each night's encrypted file to your Telegram (as a document, no
# sound), so a dead VPS disk is not the only copy. Telegram sees ciphertext.
BACKUP_TO_TELEGRAM=true

# --- Self-monitoring (/holat, alerts) ---------------------------------------
# A process that has not reported in for this long is "silent" and you are
# told. The worker reports every minute, the bot every 5, the api on each
# /health poll.
HEARTBEAT_STALE_MINUTES=10
# The Telegram reader reports once a minute; a dropped session is the
# failure you cannot see, so it gets a shorter fuse.
USERBOT_STALE_MINUTES=5
# Free space on the data disk below which /holat goes red and you are alerted
# even at night — a full disk stops everything.
DISK_MIN_FREE_GB=2
# The newest backup may be this old before it counts as stale (nightly plus
# slack for a reboot at BACKUP_TIME).
BACKUP_MAX_AGE_HOURS=30
# The same problem is repeated no more often than this while it lasts; when
# it clears you get one "tiklandi" message.
ALERT_REPEAT_HOURS=6

# --- Internal API -----------------------------------------------------------
# generate: openssl rand -hex 32
API_BEARER_TOKEN=
# Per-device tokens: `name:token` pairs, space- or comma-separated. Each opens
# the recording-upload routes and nothing else, so a phone that is lost or an
# APK someone unzips cannot read a single debt, transcript or contact back out.
# Revoking one is deleting its pair here; nothing else needs rotating.
UPLOAD_TOKENS=
API_PORT=8000
# Memory ceiling for the api container (Compose only): the kernel kills it,
# not PostgreSQL, when search runs out of RAM.
API_MEM_LIMIT=4g

# --- Scheduling -------------------------------------------------------------
TIMEZONE=Asia/Tashkent
# Evening recap time (Asia/Tashkent). Must be outside QUIET_HOURS and after MORNING_BRIEF_TIME.
REPORT_TIME=19:00
# A long evening report is split into at most this many messages (1-8).
RECAP_MAX_PARTS=4
QUIET_HOURS=23:30-07:30
BATCH_FLUSH_HOURS=3

# --- Misc -------------------------------------------------------------------
LOG_LEVEL=INFO
DEBUG=false
